# Local Postgres from `npm run db` (scripts/db.mjs). In production, a Neon/Supabase URL.
DATABASE_URI=postgres://setspace:setspace@localhost:5433/setspace
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SITE_URL=http://localhost:3123
# Stripe test mode. Leave blank to use the built-in test-card stand-in.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Production only. Sites allowed to embed this one, space-separated (your portfolio's origin).
FRAME_ANCESTORS=
# Production seed only: the admin account's password. The one-click admin button is hidden in production.
ADMIN_PASSWORD=
